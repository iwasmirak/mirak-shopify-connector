<odoo noupdate="1">
    <record id="ir_cron_mirak_shopify_sync" model="ir.cron">
        <field name="name">Mirak Connector: Synchronize Shopify Products and Stock</field>
        <field name="model_id" ref="model_mirak_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <!-- Checks every minute; each store runs according to its own interval setting -->
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mirak_shopify_translations" model="ir.cron">
        <field name="name">Mirak Connector: Import Shopify Translations</field>
        <field name="model_id" ref="model_mirak_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_translations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
