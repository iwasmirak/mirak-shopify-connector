<odoo>
    <record id="mirak_shopify_log_view_list" model="ir.ui.view">
        <field name="name">mirak.shopify.log.list</field>
        <field name="model">mirak.shopify.log</field>
        <field name="arch" type="xml">
            <list string="Shopify Logs" create="0" edit="0"
                  decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="create_date" string="Date"/>
                <field name="store_id" optional="hide"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'error'" decoration-warning="level == 'warning'"
                       decoration-info="level == 'info'"/>
                <field name="operation"/>
                <field name="product_tmpl_id" optional="show"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="mirak_shopify_log_view_form" model="ir.ui.view">
        <field name="name">mirak.shopify.log.form</field>
        <field name="model">mirak.shopify.log</field>
        <field name="arch" type="xml">
            <form string="Shopify Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="store_id"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="product_tmpl_id"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mirak_shopify_log_view_search" model="ir.ui.view">
        <field name="name">mirak.shopify.log.search</field>
        <field name="model">mirak.shopify.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="product_tmpl_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <separator/>
                <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
            </search>
        </field>
    </record>

    <record id="mirak_shopify_log_action" model="ir.actions.act_window">
        <field name="name">Shopify Logs</field>
        <field name="res_model">mirak.shopify.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
