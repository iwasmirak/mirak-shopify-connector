<odoo>
    <!-- Payouts -->
    <record id="mirak_shopify_payout_view_list" model="ir.ui.view">
        <field name="name">mirak.shopify.payout.list</field>
        <field name="model">mirak.shopify.payout</field>
        <field name="arch" type="xml">
            <list string="Shopify Payouts" create="0" edit="0">
                <field name="issued_at"/>
                <field name="name"/>
                <field name="store_id"/>
                <field name="amount_gross" sum="Total"/>
                <field name="amount_fees" sum="Total"/>
                <field name="amount_net" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="transaction_count" optional="show"/>
                <field name="reconciled_count" optional="show"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>

    <record id="mirak_shopify_payout_action" model="ir.actions.act_window">
        <field name="name">Shopify Payouts</field>
        <field name="res_model">mirak.shopify.payout</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Returns -->
    <record id="mirak_shopify_return_view_list" model="ir.ui.view">
        <field name="name">mirak.shopify.return.list</field>
        <field name="model">mirak.shopify.return</field>
        <field name="arch" type="xml">
            <list string="Shopify Returns" create="0" edit="0">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="origin"/>
                <field name="picking_id"/>
                <field name="restock_done"/>
                <field name="store_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mirak_shopify_return_action" model="ir.actions.act_window">
        <field name="name">Shopify Returns</field>
        <field name="res_model">mirak.shopify.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customers -->
    <record id="mirak_shopify_customer_view_list" model="ir.ui.view">
        <field name="name">mirak.shopify.customer.list</field>
        <field name="model">mirak.shopify.customer</field>
        <field name="arch" type="xml">
            <list string="Shopify Customers" create="0">
                <field name="partner_id"/>
                <field name="customer_gid"/>
                <field name="store_id"/>
                <field name="shopify_updated_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mirak_shopify_customer_action" model="ir.actions.act_window">
        <field name="name">Shopify Customers</field>
        <field name="res_model">mirak.shopify.customer</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
